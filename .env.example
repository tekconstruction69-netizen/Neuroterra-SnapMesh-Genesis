# Copy to .env and fill locally. NEVER commit the filled .env file.
# All values below are intentionally empty.

# Optional: Muse planner endpoint/key (design-time / advisory only.
# NeuroCore runs without it; never required on worker devices.)
MUSE_API_URL=
MUSE_API_KEY=

# Optional: Baseten cloud fallback (NT-ADAPT 2 never calls it in the
# current prototype; presence of the key is only detected, never logged.)
BASETEN_API_KEY=

# Optional: manual peer for LAN tests, e.g. 192.168.1.10:49210
SNAPMESH_PEER=
M6_PC2_HOST=
